        {
          "datasource": {
            "type": "mysql",
            "uid": "apm-doris"
          },
          "format": "table",
          "rawSql": "SELECT a.tenant_id, a.asset_id, MAX(a.asset_name) AS asset_name, COUNT(DISTINCT an.anomaly_id) AS anomaly_count, SUM(CASE WHEN an.severity='critical' THEN 1 ELSE 0 END) AS critical_count, MAX(an.window_end) AS last_anomaly FROM industrial_apm.dwd_apm_sensor_readings_rt a LEFT JOIN industrial_apm.fact_apm_anomaly_events an ON a.tenant_id=an.tenant_id AND a.asset_id=an.asset_id AND an.window_start >= NOW() - INTERVAL 1 DAY WHERE a.tenant_id='$tenant_id' AND a.event_time >= NOW() - INTERVAL 1 HOUR GROUP BY a.tenant_id, a.asset_id ORDER BY critical_count DESC, anomaly_count DESC",
          "refId": "A"
        }
      ],
      "title": "Per-Asset Health",
      "type": "table"
