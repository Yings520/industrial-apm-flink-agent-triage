        {
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "apm-clickhouse"
          },
          "format": "table",
          "refId": "A",
          "query": "SELECT tag_id, metric_name, AVG(avg_value) AS avg_signal, MAX(max_value) AS max_signal, MIN(min_value) AS min_signal, argMax(last_value, bucket_minute) AS latest_value, SUM(event_count) AS total_events, SUM(CASE WHEN has_late_arrival = 1 THEN 1 ELSE 0 END) AS late_buckets, SUM(CASE WHEN has_flatline = 1 THEN 1 ELSE 0 END) AS flatline_buckets, SUM(CASE WHEN has_missing_heartbeat = 1 THEN 1 ELSE 0 END) AS missing_heartbeat_buckets FROM industrial_apm.ads_apm_tag_signal_timeseries_1m WHERE tenant_id = '${tenant_id}' AND asset_id = '${asset_id}' AND ('${tag_id}' = 'All' OR tag_id = '${tag_id}') AND bucket_minute >= toDateTime(intDiv(${__from}, 1000)) AND bucket_minute <= toDateTime(intDiv(${__to}, 1000)) GROUP BY tag_id, metric_name ORDER BY total_events DESC LIMIT 20",
          "editorMode": "sql",
          "queryType": "sql"
        }
      ]
