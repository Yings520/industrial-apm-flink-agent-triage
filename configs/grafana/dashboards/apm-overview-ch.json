          "query": "WITH latest_diagnosis_kpi AS ( SELECT asset_id, max(snapshot_time) AS latest_snapshot_time FROM industrial_apm.ads_apm_diagnosis_kpi_snapshot WHERE tenant_id = '${tenant_id:string}' AND snapshot_time >= toDateTime(intDiv(${__from}, 1000)) AND snapshot_time <= toDateTime(intDiv(${__to}, 1000)) GROUP BY asset_id ) SELECT k.asset_id, k.diagnosis_count_24h, k.high_risk_diagnosis_count_24h, k.critical_risk_diagnosis_count_24h, k.escalation_required_count_24h, round(k.avg_confidence_24h, 2) AS avg_confidence_24h, k.latest_diagnosis_time FROM industrial_apm.ads_apm_diagnosis_kpi_snapshot k INNER JOIN latest_diagnosis_kpi l ON k.asset_id = l.asset_id AND k.snapshot_time = l.latest_snapshot_time WHERE k.tenant_id = '${tenant_id:string}' ORDER BY k.critical_risk_diagnosis_count_24h DESC, k.high_risk_diagnosis_count_24h DESC, k.escalation_required_count_24h DESC, k.latest_diagnosis_time DESC LIMIT 8",
          "queryType": "sql",
          "rawSql": "WITH latest_diagnosis_kpi AS ( SELECT asset_id, max(snapshot_time) AS latest_snapshot_time FROM industrial_apm.ads_apm_diagnosis_kpi_snapshot WHERE tenant_id = '${tenant_id:string}' AND snapshot_time >= toDateTime(intDiv(${__from}, 1000)) AND snapshot_time <= toDateTime(intDiv(${__to}, 1000)) GROUP BY asset_id ) SELECT k.asset_id, k.diagnosis_count_24h, k.high_risk_diagnosis_count_24h, k.critical_risk_diagnosis_count_24h, k.escalation_required_count_24h, round(k.avg_confidence_24h, 2) AS avg_confidence_24h, k.latest_diagnosis_time FROM industrial_apm.ads_apm_diagnosis_kpi_snapshot k INNER JOIN latest_diagnosis_kpi l ON k.asset_id = l.asset_id AND k.snapshot_time = l.latest_snapshot_time WHERE k.tenant_id = '${tenant_id:string}' ORDER BY k.critical_risk_diagnosis_count_24h DESC, k.high_risk_diagnosis_count_24h DESC, k.escalation_required_count_24h DESC, k.latest_diagnosis_time DESC LIMIT 8",
