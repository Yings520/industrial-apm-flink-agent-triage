{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-apm.local/contracts/agent_explanation.schema.json",
  "title": "agent_explanation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation_id",
    "schema_version",
    "tenant_id",
    "anomaly_id",
    "evidence_version",
    "summary",
    "findings",
    "possible_causes",
    "recommended_checks",
    "runbook_references",
    "confidence_label",
    "quality_caveats",
    "model_name",
    "prompt_version",
    "token_cost",
    "latency_ms",
    "created_at",
    "status"
  ],
  "properties": {
    "recommendation_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "agent_explanation.v1"
    },
    "tenant_id": {
      "type": "string"
    },
    "anomaly_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "component_id": {
      "type": "string"
    },
    "related_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_failure_modes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_action": {
      "type": "string"
    },
    "quality_event_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Quality event IDs that affect triage confidence"
    },
    "failure_mode_hypothesis": {
      "type": "string",
      "description": "Single best-match failure mode hypothesis from FMECA"
    },
    "failure_mode_hypothesis_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score for the failure mode hypothesis"
    },
    "evidence_version": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "possible_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runbook_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence_label": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "model_name": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "token_cost": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "quality_caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {
      "type": "string",
      "enum": ["fallback", "llm_generated", "quarantined"]
    }
  }
}
