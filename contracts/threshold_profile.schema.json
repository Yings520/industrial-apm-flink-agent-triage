{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-apm.local/contracts/threshold_profile.schema.json",
  "title": "threshold_profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "tenant_id",
    "asset_type",
    "metric_name",
    "unit",
    "rule_id",
    "method",
    "severity",
    "parameters",
    "effective_from",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "threshold_profile.v1"
    },
    "profile_id": {
      "type": "string",
      "description": "Unique threshold profile identifier"
    },
    "tenant_id": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "description": "Asset type this rule applies to. Use '*' for wildcard."
    },
    "component_type": {
      "type": "string",
      "description": "Component type filter. Null = applies to all components."
    },
    "metric_name": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "rule_name": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Rule version (semantic versioning for rules)"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_to": {
      "type": "string",
      "format": "date-time",
      "description": "Null = currently effective"
    },
    "owner": {
      "type": "string",
      "description": "Team or individual responsible for this rule"
    },
    "approval_status": {
      "type": "string",
      "enum": ["draft", "proposed", "approved", "rejected", "deprecated"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "trial"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  }
}
