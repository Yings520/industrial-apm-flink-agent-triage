{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-apm.local/contracts/late_event.schema.json",
  "title": "late_event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "tenant_id",
    "tag_id",
    "event_time",
    "ingest_time",
    "watermark_time",
    "lateness_minutes",
    "reason"
  ],
  "properties": {
    "event_id": {"type": "string"},
    "schema_version": {"type": "string", "const": "late_event.v1"},
    "tenant_id": {"type": "string"},
    "tag_id": {"type": "string"},
    "event_time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "ingest_time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "watermark_time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "lateness_minutes": {"type": "number", "minimum": 0},
    "reason": {"type": "string"}
  }
}
