{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-apm.local/contracts/anomaly_event.schema.json",
  "title": "anomaly_event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anomaly_id",
    "schema_version",
    "rule_id",
    "tenant_id",
    "plant_id",
    "asset_id",
    "asset_name",
    "tag_id",
    "tag_name",
    "metric_name",
    "observed_value",
    "baseline_value",
    "expected_value",
    "event_count",
    "breach_count",
    "window_start",
    "window_end",
    "severity",
    "quality_flags",
    "detection_confidence",
    "source_event_ids"
  ],
  "properties": {
    "anomaly_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "anomaly_event.v1"
    },
    "rule_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "plant_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "asset_name": {
      "type": "string"
    },
    "tag_id": {
      "type": "string"
    },
    "tag_name": {
      "type": "string"
    },
    "component_id": {
      "type": "string"
    },
    "metric_name": {
      "type": "string"
    },
    "observed_value": {
      "type": "number"
    },
    "baseline_value": {
      "type": ["number", "null"]
    },
    "expected_value": {
      "type": ["number", "null"]
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "breach_count": {
      "type": "integer",
      "minimum": 0
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "window_end": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"]
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "quality_event_ids": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 20,
      "uniqueItems": true,
      "description": "Structured quality event references for this anomaly window"
    },
    "fault_type": {
      "type": "string",
      "enum": ["asset_fault", "sensor_fault", "operating_context_change", "unknown"],
      "description": "Distinguishes sensor faults from asset faults"
    },
    "failure_mode_id": {
      "type": "string",
      "description": "Suspected failure mode from FMECA catalog. Null = not yet correlated."
    },
    "detection_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "uniqueItems": true
    }
  }
}
